// Mediabuyer OS — Prisma schema
// Postgres. Run: pnpm db:push (dev) or pnpm db:migrate (production)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY
// ============================================================================

enum UserRole {
  OWNER
  TEAM
  CLIENT
  VIEWER
}

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          UserRole @default(TEAM)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   OrganizationMember[]
  assignedClients ClientAssignee[]
  clientUserOf  Client[]   @relation("ClientPortalUser")
  createdTasks  Task[]     @relation("TaskCreatedBy")
  assignedTasks Task[]     @relation("TaskAssignee")
  reviewedRecs  Recommendation[] @relation("RecReviewedBy")
  generatedReports Report[] @relation("ReportGeneratedBy")
  reportComments ReportComment[]
  auditLogs     AuditLog[]
  billingPaymentsRecorded BillingPayment[] @relation("BillingPaymentRecordedBy")

  @@index([clerkId])
  @@index([email])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("internal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  clients  Client[]
  auditLogs AuditLog[]
  metaAppProfiles MetaAppProfile[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole     @default(TEAM)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================================
// CLIENT DOMAIN
// ============================================================================

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
  PROSPECT
}

enum ClientHealth {
  EXCELLENT
  GOOD
  NEEDS_ATTENTION
  AT_RISK
}

model Client {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  industry            String?
  logoUrl             String?
  status              ClientStatus @default(ACTIVE)
  health              ClientHealth @default(GOOD)
  monthlyBudget       Decimal?     @db.Decimal(12, 2)
  minCpa              Decimal?     @db.Decimal(10, 2)
  maxCpa              Decimal?     @db.Decimal(10, 2)
  minRoas             Decimal?     @db.Decimal(6, 2)
  reportingCurrency   String       @default("USD")
  // Loopa's own service fee and billing contact. Deliberately separate from
  // monthlyBudget, which is the client's ADVERTISING budget and is consumed by
  // overview pacing (src/app/(app)/clients/[id]/page.tsx). billingEnabled is an
  // explicit opt-in so no existing client is silently in billing scope.
  serviceFeeAmount      Decimal?  @db.Decimal(12, 2)
  serviceFeeCurrency    String?
  billingContactName    String?
  billingContactEmail   String?
  billingCycleStartDate DateTime? @db.Date
  billingEnabled        Boolean   @default(false)
  // Portal-facing user (single-user client login). For multi-user clients,
  // add a separate ClientPortalMember model later.
  portalUserId        String?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portalUser          User?               @relation("ClientPortalUser", fields: [portalUserId], references: [id])
  assignees           ClientAssignee[]
  adAccountConnections AdAccountConnection[]
  alerts              Alert[]
  tasks               Task[]
  recommendations     Recommendation[]
  reports             Report[]
  strategies          Strategy[]
  billingCycles       BillingCycle[]

  @@index([organizationId, status])
  @@index([health])
}

model ClientAssignee {
  id       String @id @default(cuid())
  clientId String
  userId   String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CampaignObjectiveType {
  SALES
  LEADS
  TRAFFIC
  ENGAGEMENT
  AWARENESS
  APP_PROMOTION
  OTHER
}

model Strategy {
  id              String         @id @default(cuid())
  clientId        String
  name            String?
  status          StrategyStatus @default(ACTIVE)
  periodStart     DateTime
  periodEnd       DateTime
  monthlyBudget   Decimal?       @db.Decimal(12, 2)
  revenueGoal     Decimal?       @db.Decimal(12, 2)
  conversionGoal  Int?
  minCpa          Decimal?       @db.Decimal(10, 2)
  maxCpa          Decimal?       @db.Decimal(10, 2)
  minRoas         Decimal?       @db.Decimal(6, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client          Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  objectives      StrategyObjective[]

  @@index([clientId, status])
}

model StrategyObjective {
  id              String                @id @default(cuid())
  strategyId      String
  type            CampaignObjectiveType
  allocatedBudget Decimal               @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  strategy        Strategy              @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, type])
}

// ============================================================================
// AD ACCOUNT CONNECTIONS
// ============================================================================

enum AdPlatform {
  META
  GOOGLE   // not used in v1 but kept for forward compatibility
  TIKTOK
  LINKEDIN
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

// A workspace-owned Meta App. Each organization can register one or more of
// its own Meta apps (BYO-app). The app secret is encrypted at rest with the
// same AES-256-GCM helper used for access tokens (lib/encryption.ts).
model MetaAppProfile {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  appId          String
  // Encrypted with AES-256-GCM (see lib/encryption.ts). Never returned to the client.
  appSecretEnc   String
  apiVersion     String   @default("v23.0")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connections  AdAccountConnection[]

  @@unique([organizationId, appId])
  @@index([organizationId])
}

// Short-lived server-side store for an in-progress Meta OAuth connection.
// Replaces cookie-based storage: media buyers with many ad accounts can exceed
// the browser cookie size limit. Only an unguessable session id is stored in
// the client cookie; the encrypted token + full ad-account list live here.
// Rows are purged after `expiresAt` (15 min TTL) by a scheduled job.
model PendingMetaOAuthSession {
  id               String   @id
  userId           String
  organizationId   String
  clientId         String
  metaAppProfileId String
  // Long-lived Meta access token, encrypted with AES-256-GCM (lib/encryption.ts).
  accessTokenEnc   String
  tokenExpiresAt   DateTime
  // Snapshot of the ad accounts the token can access: { id, name, currency, timezone }[].
  accounts         Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([expiresAt])
}

model AdAccountConnection {
  id                  String           @id @default(cuid())
  clientId            String
  platform            AdPlatform       @default(META)
  platformAccountId   String           // e.g. Meta "act_123456789"
  accountName         String
  currency            String           @default("USD")
  timezone            String           @default("UTC")
  // Encrypted with AES-256-GCM (see lib/encryption.ts). Format: iv:ciphertext:authTag (hex).
  accessTokenEnc      String?
  refreshTokenEnc     String?
  tokenExpiresAt      DateTime?
  status              ConnectionStatus @default(ACTIVE)
  // Legacy "any successful sync" timestamp. Kept for backward compatibility:
  // still updated after every successful job. Do NOT use it to decide
  // initial-vs-incremental — use insightsBackfilledAt instead.
  lastSyncedAt        DateTime?
  // Set only when a STRUCTURAL job succeeds.
  structuralSyncedAt  DateTime?
  // Set only when an INSIGHTS_BACKFILL job succeeds. Null until a full
  // backfill has completed; this is the signal for initial-vs-incremental.
  insightsBackfilledAt DateTime?
  lastSyncError       String?
  // Workspace-owned Meta app used to authorize this connection. Nullable so
  // legacy rows (authorized before BYO-app, or pre-created shells) stay valid;
  // those fall back to env META_APP_ID/SECRET. Required for all new connections.
  metaAppProfileId    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metaAppProfile MetaAppProfile? @relation(fields: [metaAppProfileId], references: [id], onDelete: Restrict)
  campaigns      Campaign[]
  creatives      Creative[]
  syncJobs       SyncJob[]
  fundingCycles  FundingCycle[]

  @@unique([platform, platformAccountId])
  @@index([clientId])
  @@index([status])
  @@index([metaAppProfileId])
}

// ============================================================================
// FUNDING CYCLES (manual funding-cycle tracking + email-dedupe)
// ============================================================================

model FundingCycle {
  id                    String   @id @default(cuid())
  adAccountConnectionId String
  amount                Decimal  @db.Decimal(12, 2)
  currency              String
  startedAt             DateTime @default(now())
  cancelledAt           DateTime?
  note                  String?
  createdAt             DateTime @default(now())

  adAccountConnection AdAccountConnection @relation(fields: [adAccountConnectionId], references: [id], onDelete: Cascade)
  alertsSent          FundAlertSent[]

  @@index([adAccountConnectionId, startedAt])
}

model FundAlertSent {
  id             String   @id @default(cuid())
  fundingCycleId String
  threshold      Int // 50, 75, 90, 100
  sentAt         DateTime @default(now())

  fundingCycle FundingCycle @relation(fields: [fundingCycleId], references: [id], onDelete: Cascade)

  @@unique([fundingCycleId, threshold])
}

// ============================================================================
// CLIENT BILLING (Loopa service fee — FIXED model, EGP, 50/50)
//
// Loopa's own client billing: a fixed monthly service fee, invoiced in EGP,
// paid in exactly two 50% installments. Entirely separate from the FUNDING
// CYCLES section above — that tracks money the client puts INTO Meta for ad
// spend and is keyed to an AdAccountConnection. Billing is keyed to the Client
// and never touches any Meta model.
//
// Invariants (load-bearing — read before changing anything here):
//
// (a) SNAPSHOTS. BillingCycle.feeAmount / .currency are snapshots taken at
//     cycle creation. Raising Client.serviceFeeAmount later must NEVER
//     restate an already-issued invoice.
//
// (b) DERIVED BALANCES. "Amount received" and "outstanding balance" are
//     derived from BillingPayment rows at query time and are NEVER stored.
//     Same rule as the InsightsBreakdownDaily comment below: no second source
//     of truth for a computed figure.
//
// (c) DATES. Every @db.Date field is an Africa/Cairo CIVIL DATE stored at UTC
//     midnight (the convention already used for InsightsDaily.date — see
//     src/lib/month.ts). paidAt / sentAt are instants (UTC) recording when an
//     action happened. Calendar-day arithmetic (due = D+15, reminder = D+14)
//     is done on the civil date, never by adding milliseconds to an instant —
//     Egypt observes DST, so a fixed offset breaks twice a year.
//
// (d) MONEY. Storage is Decimal(12, 2), but ALL arithmetic happens in integer
//     piasters (1 EGP = 100 piasters). Fractional piasters are never stored.
//     The 50/50 split gives any odd piaster to installment 1:
//     EGP 10,000.01 -> 5,000.01 + 5,000.00, summing back exactly.
//
// Automatic creation of the FOLLOWING month's BillingCycle is deferred and is
// NOT implemented in commits B-1 through B-8. In that scope a cycle is created
// only by the user's "Record first installment" action. The
// @@unique([clientId, periodStart]) key exists so that the future monthly
// bootstrap is a pure code addition needing no further migration.
// ============================================================================

enum BillingCycleStatus {
  OPEN
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

enum BillingPaymentMethod {
  BANK_TRANSFER
  INSTAPAY
  CASH
  CHEQUE
  OTHER
}

enum BillingEmailKind {
  // The invoice for an installment. Deliberately generic: the same kind covers
  // installment 1 and installment 2, because BillingEmailDelivery is already
  // keyed @@unique([billingInstallmentId, kind]) — so one delivery row per
  // installment per kind, with no first/second variants needed.
  //
  // "Invoice sent" is NOT an installment status. BillingInstallment.status
  // stays purely financial (PENDING / PAID / CANCELLED); the awaiting-payment
  // UI state is derived from the existence of the installment plus this
  // delivery row's state plus that financial status.
  INSTALLMENT_INVOICE
  PAYMENT_RECEIPT
  SECOND_INSTALLMENT_REMINDER_CLIENT
  SECOND_INSTALLMENT_REMINDER_INTERNAL
}

enum BillingEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// One month of service fee for one client. feeAmount/currency are snapshots
// (invariant a). periodStart/periodEnd are Cairo civil dates (invariant c).
model BillingCycle {
  id          String             @id @default(cuid())
  clientId    String
  periodStart DateTime           @db.Date
  periodEnd   DateTime           @db.Date
  feeAmount   Decimal            @db.Decimal(12, 2)
  currency    String
  status      BillingCycleStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  installments BillingInstallment[]

  // Idempotent cycle creation: a duplicate bootstrap for the same period is a
  // P2002, never a second cycle.
  @@unique([clientId, periodStart])
  @@index([clientId, periodStart])
}

// Exactly two per cycle in v1: sequence 1 and 2, 50% each. sharePercent is
// recorded for auditability but is not user-editable (percentage billing and
// custom installment percentages are explicitly out of scope).
//
// Installment 2's dueDate/reminderDate stay null until installment 1 is paid;
// they are then set to D+15 / D+14 from the recorded payment date (invariant c).
model BillingInstallment {
  id             String            @id @default(cuid())
  billingCycleId String
  sequence       Int
  sharePercent   Int
  amountDue      Decimal           @db.Decimal(12, 2)
  currency       String
  status         InstallmentStatus @default(PENDING)
  dueDate        DateTime?         @db.Date
  reminderDate   DateTime?         @db.Date
  paidAt         DateTime?
  invoiceNumber  String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  billingCycle BillingCycle           @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  payment      BillingPayment?
  deliveries   BillingEmailDelivery[]

  // Concurrency guard for second-installment creation.
  @@unique([billingCycleId, sequence])
  // Scan index for the daily reminder job (status + reminderDate <= today).
  @@index([status, reminderDate])
}

// Financial truth. Append-only: never updated, never deleted.
//
// billingInstallmentId is @unique — one payment per installment in v1. That is
// the double-click / concurrent-submit guard: the loser gets a P2002 and is
// reported as an idempotent success. It also forecloses partial payments,
// which is correct for a fixed 50/50 schedule and must be revisited only if
// partial payments enter scope.
//
// clientId is deliberately a denormalized scalar with NO relation, matching
// AiRun.clientId, so client-level payment history is one indexed read.
//
// recordedById is a nullable FK to User with onDelete: SetNull — deleting a
// user nulls the attribution but must NEVER cascade into, or otherwise
// rewrite, the financial record itself.
model BillingPayment {
  id                   String               @id @default(cuid())
  billingInstallmentId String               @unique
  clientId             String
  amountReceived       Decimal              @db.Decimal(12, 2)
  currency             String
  paymentDate          DateTime             @db.Date
  method               BillingPaymentMethod
  reference            String?
  internalNote         String?
  receiptNumber        String               @unique
  recordedById         String?
  createdAt            DateTime             @default(now())

  installment BillingInstallment @relation(fields: [billingInstallmentId], references: [id], onDelete: Restrict)
  recordedBy  User?              @relation("BillingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([clientId, paymentDate])
}

// Delivery ledger for all three billing emails (receipt, client reminder,
// internal reminder), discriminated by `kind`.
//
// Deliberately richer than FundAlertSent, which records success only and has no
// retry state. Here @@unique([billingInstallmentId, kind]) is the dedupe key and
// `status` makes the claim a compare-and-swap: a row is claimed by moving it to
// SENDING before the send, so a concurrent cron run cannot double-send. A row
// left in SENDING for over 30 minutes (crash mid-send) is automatically
// reclaimed and retried for ALL kinds — including PAYMENT_RECEIPT — up to 5
// attempts; after that it stays FAILED for a manual retry. SENT is never
// reclaimed. Accepted trade-off: at-least-once delivery, with a duplicate
// possible only if a crash lands in the sub-second window between SMTP
// accepting the message and the SENT write committing.
model BillingEmailDelivery {
  id                   String             @id @default(cuid())
  billingInstallmentId String
  kind                 BillingEmailKind
  status               BillingEmailStatus @default(PENDING)
  recipient            String
  subject              String
  attempts             Int                @default(0)
  lastError            String?
  messageId            String?
  sentAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  installment BillingInstallment @relation(fields: [billingInstallmentId], references: [id], onDelete: Cascade)

  @@unique([billingInstallmentId, kind])
  @@index([status])
}

// Gapless invoice / receipt numbering, e.g. scope "INV-2026", "RCT-2026".
// Allocated inside the payment transaction with an atomic increment, so a
// rolled-back payment burns no number.
model BillingDocumentCounter {
  scope     String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ============================================================================
// AD ENTITIES (mirrored from Meta)
// ============================================================================

model Campaign {
  id                     String   @id @default(cuid())
  adAccountConnectionId  String
  platformId             String
  name                   String
  objective              String?
  status                 String?
  effectiveStatus        String?
  dailyBudget            Decimal? @db.Decimal(12, 2)
  lifetimeBudget         Decimal? @db.Decimal(12, 2)
  buyingType             String?
  startTime              DateTime?
  stopTime               DateTime?
  specialAdCategories    Json?
  raw                    Json?
  updatedAt              DateTime @updatedAt

  adAccountConnection AdAccountConnection @relation(fields: [adAccountConnectionId], references: [id], onDelete: Cascade)
  adSets              AdSet[]

  @@unique([adAccountConnectionId, platformId])
  @@index([adAccountConnectionId])
  @@index([effectiveStatus])
}

model AdSet {
  id                 String   @id @default(cuid())
  campaignId         String
  platformId         String
  name               String
  status             String?
  effectiveStatus    String?
  dailyBudget        Decimal? @db.Decimal(12, 2)
  lifetimeBudget     Decimal? @db.Decimal(12, 2)
  optimizationGoal   String?
  billingEvent       String?
  bidStrategy        String?
  targeting          Json?
  startTime          DateTime?
  endTime            DateTime?
  raw                Json?
  updatedAt          DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@unique([campaignId, platformId])
  @@index([campaignId])
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  DPA
  COLLECTION
  OTHER
}

model Creative {
  id                    String       @id @default(cuid())
  adAccountConnectionId String
  platformId            String
  name                  String
  type                  CreativeType @default(IMAGE)
  thumbnailUrl          String?
  imageUrl              String?
  videoUrl              String?
  bodyText              String?
  headline              String?
  linkUrl               String?
  callToAction          String?
  // Asset-identity fields (nullable; populate on next structural sync). Used to
  // group duplicate Creative rows that point at the same underlying asset/post.
  objectStoryId           String?
  effectiveObjectStoryId  String?
  imageHash               String?
  videoId                 String?
  isWinner              Boolean      @default(false) // tagged manually or via rule
  raw                   Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  adAccountConnection AdAccountConnection @relation(fields: [adAccountConnectionId], references: [id], onDelete: Cascade)
  ads                 Ad[]
  assets              CreativeAsset[]

  @@unique([adAccountConnectionId, platformId])
  @@index([adAccountConnectionId])
}

// ============================================================================
// CREATIVE ASSET INGESTION (V3 — local-storage image ingestion)
//
// Additive only. Mirrors the underlying media for spending creatives into a
// private, locally-persisted store served exclusively through an
// authenticated route. cdnUrl is reserved for a future S3/CDN driver and is
// left null in Step 1 (local-storage image ingestion).
// ============================================================================

enum CreativeAssetKind {
  IMAGE
  VIDEO
  POSTER
}

enum CreativeAssetStatus {
  PENDING
  RESOLVING
  FETCHING
  READY
  FAILED
  UNAVAILABLE
}

model CreativeAsset {
  id          String              @id @default(cuid())
  creativeId  String
  kind        CreativeAssetKind
  status      CreativeAssetStatus @default(PENDING)
  sourceUrl   String?
  storageKey  String?
  // Reserved for a future S3/CDN driver. Stays null while the local driver
  // is in use (Step 1).
  cdnUrl      String?
  width       Int?
  height      Int?
  bytes       Int?
  mimeType    String?
  contentHash String?
  attempts    Int                 @default(0)
  lastError   String?
  resolvedAt  DateTime?
  storedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  creative    Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([creativeId, kind])
  @@index([status])
  @@index([contentHash])
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model IngestionJob {
  id         String             @id @default(cuid())
  creativeId String
  kind       CreativeAssetKind
  status     IngestionJobStatus @default(PENDING)
  attempts   Int                @default(0)
  lastError  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
}

model Ad {
  id              String   @id @default(cuid())
  adSetId         String
  platformId      String
  name            String
  status          String?
  effectiveStatus String?
  creativeId      String?
  raw             Json?
  updatedAt       DateTime @updatedAt

  adSet    AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@unique([adSetId, platformId])
  @@index([adSetId])
}

// ============================================================================
// INSIGHTS (daily time-series)
// ============================================================================

enum InsightEntity {
  ACCOUNT
  CAMPAIGN
  AD_SET
  AD
}

model InsightsDaily {
  id               String        @id @default(cuid())
  entityType       InsightEntity
  entityId         String        // internal ID (Campaign.id / AdSet.id / Ad.id / AdAccountConnection.id)
  date             DateTime      @db.Date
  // Core delivery
  impressions      Int           @default(0)
  reach            Int           @default(0)
  clicks           Int           @default(0)
  spend            Decimal       @default(0) @db.Decimal(12, 2)
  frequency        Decimal?      @db.Decimal(6, 2)
  // Rates
  ctr              Decimal?      @db.Decimal(6, 4)
  cpc              Decimal?      @db.Decimal(10, 4)
  cpm              Decimal?      @db.Decimal(10, 2)
  // Conversions
  conversions      Int           @default(0)
  purchases        Int           @default(0)
  leads            Int           @default(0)
  conversionValue  Decimal       @default(0) @db.Decimal(12, 2)
  roas             Decimal?      @db.Decimal(8, 4)
  cpa              Decimal?      @db.Decimal(10, 2)
  // Video
  videoViews3s     Int?
  videoViewsP25    Int?
  videoViewsP50    Int?
  videoViewsP75    Int?
  videoViewsP100   Int?
  videoAvgTime     Decimal?      @db.Decimal(6, 2)
  hookRate         Decimal?      @db.Decimal(6, 4) // video_play_3s / impressions
  thumbstopRate    Decimal?      @db.Decimal(6, 4)
  // Raw payload for forward-compat
  raw              Json?
  createdAt        DateTime      @default(now())

  @@unique([entityType, entityId, date])
  @@index([entityType, entityId])
  @@index([date])
}

// Breakdown dimensions stored in InsightsBreakdownDaily.
//
// PLACEMENT contract (combined breakdown stored as a composite value):
//   - PLACEMENT stores the Meta breakdown combination
//     `publisher_platform,platform_position`. Meta rejects `platform_position`
//     on its own; the pair is what yields the Instagram-Reels vs
//     Instagram-Feed vs Facebook-Feed view a media buyer needs.
//   - Its `value` is the COMPOSITE "{publisher_platform}|{platform_position}",
//     pipe-delimited, in that order — e.g. "instagram|instagram_reels",
//     "facebook|feed".
//   - The pipe is a safe delimiter: Meta's values for these two dimensions
//     contain no pipe characters.
//   - The composite exists so the
//     `@@unique([entityType, entityId, date, dimension, value])` key stays
//     unchanged (no dimension2/value2, no index rebuild, no PostgreSQL
//     NULLs-are-distinct hole) and existing PUBLISHER_PLATFORM rows are
//     untouched.
//   - PUBLISHER_PLATFORM and PLACEMENT are SEPARATE dimensions and therefore
//     separate rows. Consumers must filter by `dimension`; never sum across
//     dimensions.
enum BreakdownDimension {
  PUBLISHER_PLATFORM
  PLATFORM_POSITION
  IMPRESSION_DEVICE
  GENDER
  AGE
  COUNTRY
  REGION
  PLACEMENT
}

// Dimensional breakdown insights (placement / platform / gender / age / device / geo).
// Mirrors the polymorphic style of InsightsDaily (no FK relation, same Decimal precisions).
//
// (a) ROAS/CPA are deliberately NOT stored. They are derived at query time from
//     spend / purchases / conversionValue, matching how Analysis already computes them,
//     so there is never a second source of truth for those ratios.
// (b) `reach` and `frequency` are deliberately NOT stored because they are non-additive
//     across breakdown values — summing reach across platforms double-counts people.
// (c) Breakdown totals may not reconcile exactly with entity-level InsightsDaily totals.
//     This data is a split for comparison, never a restatement of account totals.
model InsightsBreakdownDaily {
  id              String             @id @default(cuid())
  entityType      InsightEntity
  entityId        String             // internal ID (AdAccountConnection.id / Campaign.id / Ad.id)
  date            DateTime           @db.Date
  dimension       BreakdownDimension
  value           String             // Meta's breakdown value, e.g. "facebook", "female", "25-34"

  impressions     Int                @default(0)
  clicks          Int                @default(0)
  spend           Decimal            @default(0) @db.Decimal(12, 2)
  purchases       Int                @default(0)
  conversionValue Decimal            @default(0) @db.Decimal(12, 2)

  raw             Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([entityType, entityId, date, dimension, value])
  @@index([entityType, entityId, dimension, date])
  @@index([dimension, date])
}

// ============================================================================
// WORKFLOW: alerts, tasks, recommendations, reports
// ============================================================================

enum AlertType {
  CPA_SPIKE
  ROAS_DROP
  SPEND_PACING_OVER
  SPEND_PACING_UNDER
  AD_FATIGUE
  UNDER_DELIVERY
  ACCOUNT_STATUS
  CREATIVE_FATIGUE
  BUDGET_DEPLETED
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Alert {
  id             String         @id @default(cuid())
  clientId       String
  type           AlertType
  severity       AlertSeverity  @default(WARNING)
  entityType     InsightEntity?
  entityId       String?
  title          String
  message        String
  rule           String?        // human-readable rule label, e.g. "ROAS < 1.5 for 3 days"
  status         AlertStatus    @default(OPEN)
  triggeredAt    DateTime       @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  metadata       Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([severity])
  @@index([triggeredAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DISMISSED
}

enum TaskPriority {
  LOW
  MED
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  ALERT
  AI_RECOMMENDATION
  RULE
}

model Task {
  id          String        @id @default(cuid())
  clientId    String
  entityType  InsightEntity?
  entityId    String?
  title       String
  description String?
  rule        String?       // e.g. "ROAS < 1.5 for 3 days"
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MED)
  source      TaskSource    @default(MANUAL)
  sourceRefId String?
  assigneeId  String?
  createdById String?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee   User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User?  @relation("TaskCreatedBy", fields: [createdById], references: [id])

  attachments TaskAttachment[]

  @@index([clientId, status])
  @@index([assigneeId, status])
  @@index([priority])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum RecommendationAction {
  PAUSE
  SCALE
  TEST
  INVESTIGATE
  COPY_WINNER
  REFRESH_CREATIVE
  ADJUST_BUDGET
  ADJUST_TARGETING
}

enum RecommendationStatus {
  PENDING
  APPROVED
  DISMISSED
  ACTED_ON
}

model Recommendation {
  id               String                @id @default(cuid())
  clientId         String
  entityType       InsightEntity
  entityId         String
  entityName       String?
  action           RecommendationAction
  priority         TaskPriority          @default(MED)
  confidence       Decimal               @db.Decimal(4, 3)
  reasoning        String
  supportingData   Json?
  status           RecommendationStatus  @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  taskId           String? // when promoted to a task
  createdAt        DateTime              @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("RecReviewedBy", fields: [reviewedById], references: [id])

  @@index([clientId, status])
  @@index([createdAt])
}

enum ReportType {
  WEEKLY
  MONTHLY
  ADHOC
}

enum ReportStatus {
  DRAFT
  SENT
  VIEWED
  ARCHIVED
}

model Report {
  id              String       @id @default(cuid())
  clientId        String
  type            ReportType   @default(WEEKLY)
  periodStart     DateTime
  periodEnd       DateTime
  status          ReportStatus @default(DRAFT)
  summary         String?
  metricsSnapshot Json?
  pdfUrl          String?
  shareToken      String?      @unique
  generatedById   String?
  generatedAt     DateTime     @default(now())
  sentAt          DateTime?
  viewedAt        DateTime?

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  generatedBy User?           @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  comments    ReportComment[]

  @@index([clientId])
  @@index([generatedAt])
}

model ReportComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ============================================================================
// OBSERVABILITY: sync jobs, AI runs, audit log
// ============================================================================

enum SyncJobType {
  STRUCTURAL
  INSIGHTS_INCREMENTAL
  INSIGHTS_BACKFILL
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model SyncJob {
  id                    String        @id @default(cuid())
  adAccountConnectionId String
  type                  SyncJobType
  status                SyncJobStatus @default(PENDING)
  recordsSynced         Int           @default(0)
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())

  adAccountConnection AdAccountConnection @relation(fields: [adAccountConnectionId], references: [id], onDelete: Cascade)

  @@index([adAccountConnectionId, status])
  @@index([createdAt])
}

enum AiRunType {
  DAILY_INSIGHTS
  WEEKLY_REPORT
  RECOMMENDATION_BATCH
  ONE_OFF
}

enum AiRunStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model AiRun {
  id            String      @id @default(cuid())
  type          AiRunType
  clientId      String?
  inputHash     String
  promptVersion String
  model         String
  inputTokens   Int
  outputTokens  Int
  costUsd       Decimal     @db.Decimal(10, 6)
  latencyMs     Int
  status        AiRunStatus
  output        Json?
  errorMessage  String?
  createdAt     DateTime    @default(now())

  @@index([type, createdAt])
  @@index([clientId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String   // e.g. "client.create", "task.update", "connection.delete"
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
}
